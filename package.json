{
  "name": "android-pc-companion",
  "version": "2.0.0",
  "description": "PC companion app for Android devices: mirroring, battery, files, sideloading, app management, bootloader unlock.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "extract-zip": "^2.0.1",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jsqr": "^1.4.0"
  },
  "build": {
    "appId": "com.example.androidcompanion",
    "productName": "Companion",
    "publish": false,
    "asarUnpack": [
      "assets/**"
    ],
    "files": [
      "**/*",
      "!tools/**",
      "!r8.jar",
      "!temp_src/**",
      "!temp_classes/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "smartphone.ico"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "smartphone.png"
    }
  }
}
